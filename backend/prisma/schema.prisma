generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  super_admin
  accountant
  warden
}

enum MaintenanceStatus {
  Open
  InProgress
  Resolved
}

enum BookingStatus {
  Pending
  Paid
  Confirmed
  CheckedIn
  Completed
  Expired
  Cancelled
  Refunded
}

model AcademicYear {
  id             String        @id @default(uuid())
  name           String        @unique // e.g. "2026/2027"
  startsAt       DateTime      @map("starts_at")
  endsAt         DateTime      @map("ends_at")
  status         String        @default("active")
  bookings       Booking[]
  waitingEntries WaitingList[]
  hostelRatings  HostelRating[]

  @@map("academic_years")
}

model Student {
  id             String        @id @default(uuid())
  regNo          String        @unique @map("reg_no")
  name           String
  gender         String
  course         String
  year           Int
  phone          String?
  email          String?
  password       String
  status         String        @default("active")
  bookings       Booking[]
  waitingEntries WaitingList[]
  chatMessages   ChatMessage[]
  maintenanceRequests MaintenanceRequest[]
  hostelRatings  HostelRating[]
  notifications  Notification[]

  @@map("students")
}

// RUCU's official student list, uploaded by the super admin. New accounts must
// match a row here (when the table is not empty).
model RegisteredStudent {
  id         String   @id @default(uuid())
  regKey     String   @unique @map("reg_key") // upper-case, no spaces
  regNo      String   @map("reg_no")          // as the registrar writes it
  name       String
  course     String
  year       Int
  gender     String?
  importedAt DateTime @default(now()) @map("imported_at")

  @@map("registered_students")
}

model Hostel {
  id             String         @id @default(uuid())
  name           String
  genderAllowed  String         @map("gender_allowed")
  location       String?
  rooms          Room[]
  waitingEntries WaitingList[]
  announcements  Announcement[]
  chatMessages   ChatMessage[]
  maintenanceRequests MaintenanceRequest[]
  hostelRatings  HostelRating[]

  @@map("hostels")
}

model Room {
  id       String  @id @default(uuid())
  hostelId String  @map("hostel_id")
  hostel   Hostel  @relation(fields: [hostelId], references: [id])
  number   String
  floor    Int?
  price    Decimal @db.Decimal(10, 2)
  beds     Bed[]

  @@map("rooms")
}

model Bed {
  id       String    @id @default(uuid())
  roomId   String    @map("room_id")
  room     Room      @relation(fields: [roomId], references: [id])
  number   String
  status   String    @default("free")
  bookings Booking[]

  @@map("beds")
}

model Booking {
  id             String        @id @default(uuid())
  studentId      String        @map("student_id")
  student        Student       @relation(fields: [studentId], references: [id])
  bedId          String        @map("bed_id")
  bed            Bed           @relation(fields: [bedId], references: [id])
  academicYearId String        @map("academic_year_id")
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id])
  status         BookingStatus @default(Pending)
  expiresAt      DateTime      @map("expires_at")
  checkedInAt    DateTime?     @map("checked_in_at")
  qrCode         String?       @unique @map("qr_code")
  createdAt      DateTime      @default(now()) @map("created_at")
  payment        Payment?

  @@map("bookings")
}

model Payment {
  id             String            @id @default(uuid())
  bookingId      String            @unique @map("booking_id")
  booking        Booking           @relation(fields: [bookingId], references: [id])
  controlNumber  String            @unique @map("control_number")
  amount         Decimal           @db.Decimal(10, 2)
  status         String            @default("pending")
  paidAt         DateTime?         @map("paid_at")
  channel        String?
  refundedAt     DateTime?         @map("refunded_at")
  refundedAmount Decimal?          @db.Decimal(10, 2) @map("refunded_amount")
  callbacks      PaymentCallback[]

  @@map("payments")
}

model PaymentCallback {
  id         String   @id @default(uuid())
  paymentId  String   @map("payment_id")
  payment    Payment  @relation(fields: [paymentId], references: [id])
  gatewayRef String   @unique @map("gateway_ref")
  receivedAt DateTime @default(now()) @map("received_at")

  @@map("payment_callbacks")
}

model User {
  id            String         @id @default(uuid())
  username      String         @unique
  password      String
  name          String
  role          UserRole
  announcements Announcement[]
  resolvedMaintenanceRequests MaintenanceRequest[]

  @@map("users")
}

model WaitingList {
  id             String       @id @default(uuid())
  studentId      String       @map("student_id")
  student        Student      @relation(fields: [studentId], references: [id])
  hostelId       String       @map("hostel_id")
  hostel         Hostel       @relation(fields: [hostelId], references: [id])
  academicYearId String       @map("academic_year_id")
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  status         String       @default("waiting") // waiting | notified | booked | cancelled
  joinedAt       DateTime     @default(now()) @map("joined_at")

  @@unique([studentId, hostelId, academicYearId])
  @@map("waiting_list")
}

model Announcement {
  id            String   @id @default(uuid())
  title         String
  message       String
  hostelId      String?  @map("hostel_id")
  hostel        Hostel?  @relation(fields: [hostelId], references: [id])
  createdBy     String   @map("created_by")
  author        User     @relation(fields: [createdBy], references: [id])
  createdAt     DateTime @default(now()) @map("created_at")
  documentTitle String?  @map("document_title")
  fileName      String?  @map("file_name")
  filePath      String?  @map("file_path")
  fileSize      Int?     @map("file_size")

  @@map("announcements")
}

// A chat message in a group. hostelId = null means the message belongs to
// the global "All Hostels" group; a real hostelId means it belongs to that
// hostel's own group (membership = currently having an active booking there).
model ChatMessage {
  id          String   @id @default(uuid())
  hostelId    String?  @map("hostel_id")
  hostel      Hostel?  @relation(fields: [hostelId], references: [id])
  studentId   String   @map("student_id")
  student     Student  @relation(fields: [studentId], references: [id])
  message     String?
  messageType String   @default("text") @map("message_type")
  fileName    String?  @map("file_name")
  filePath    String?  @map("file_path")
  fileSize    Int?     @map("file_size")
  mimeType    String?  @map("mime_type")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("chat_messages")
}

// A maintenance/repair report from a student. "location" is free text so
// students can describe either their own room/bed or any common area
// (bathroom, corridor, common room, etc.) within their hostel.
model MaintenanceRequest {
  id           String            @id @default(uuid())
  studentId    String            @map("student_id")
  student      Student           @relation(fields: [studentId], references: [id])
  hostelId     String            @map("hostel_id")
  hostel       Hostel            @relation(fields: [hostelId], references: [id])
  location     String
  description  String
  status       MaintenanceStatus @default(Open)
  resolvedNote String?           @map("resolved_note")
  resolvedById String?           @map("resolved_by_id")
  resolvedBy   User?             @relation(fields: [resolvedById], references: [id])
  resolvedAt   DateTime?         @map("resolved_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@map("maintenance_requests")
}

// A student's rating (1-5) and optional comment for their current hostel,
// for a given academic year. One rating per student/hostel/year; rating
// again just updates it (see @@unique below).
model HostelRating {
  id             String       @id @default(uuid())
  studentId      String       @map("student_id")
  student        Student      @relation(fields: [studentId], references: [id])
  hostelId       String       @map("hostel_id")
  hostel         Hostel       @relation(fields: [hostelId], references: [id])
  academicYearId String       @map("academic_year_id")
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  rating         Int
  comment        String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([studentId, hostelId, academicYearId])
  @@map("hostel_ratings")
}

// An in-app notification for a student (bell icon). "link" is an optional
// frontend route to send them to when they click it (e.g. "/dashboard/maintenance").
model Notification {
  id        String   @id @default(uuid())
  studentId String   @map("student_id")
  student   Student  @relation(fields: [studentId], references: [id])
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

// Audit trail of sensitive actions taken by staff (super_admin, warden,
// accountant) - payment confirmations, maintenance status changes,
// announcements, hostel/room/bed price or data changes, etc.
// Visible to super_admin only. Writing to this must never block or fail
// the real action it is logging (see AuditLogService.log()).
model AuditLog {
  id          String   @id @default(uuid())
  actorId     String   @map("actor_id")
  actorName   String   @map("actor_name")
  actorRole   String   @map("actor_role")
  action      String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  description String
  beforeData  Json?    @map("before_data")
  afterData   Json?    @map("after_data")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
